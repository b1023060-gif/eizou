
# alien_morph.py

import cv2
import numpy as np
import mediapipe as mp

mp_face = mp.solutions.face_mesh
face_mesh = mp_face.FaceMesh(static_image_mode=True)

def get_landmarks(img):
    h,w = img.shape[:2]
    results = face_mesh.process(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))
    if not results.multi_face_landmarks:
        return None
    lm = results.multi_face_landmarks[0].landmark
    pts = [(int(p.x*w), int(p.y*h)) for p in lm]
    return pts

# helper: rect -> subdiv for Delaunay
def delaunay_triangles(rect, points):
    subdiv = cv2.Subdiv2D(rect)
    for p in points:
        subdiv.insert(tuple(p))
    triangleList = subdiv.getTriangleList()
    tri_indices = []
    for t in triangleList:
        pts = [(int(t[0]), int(t[1])), (int(t[2]), int(t[3])), (int(t[4]), int(t[5]))]
        idx = []
        for p in pts:
            for i,pp in enumerate(points):
                if abs(pp[0]-p[0])<1 and abs(pp[1]-p[1])<1:
                    idx.append(i)
                    break
        if len(idx)==3:
            tri_indices.append(tuple(idx))
    return tri_indices

def warp_triangle(src, dst, t_src, t_dst):
    # bounding rects
    r1 = cv2.boundingRect(np.float32([t_src]))
    r2 = cv2.boundingRect(np.float32([t_dst]))
    t1Rect = []
    t2Rect = []
    t2RectInt = []
    for i in range(3):
        t1Rect.append(((t_src[i][0] - r1[0]),(t_src[i][1] - r1[1])))
        t2Rect.append(((t_dst[i][0] - r2[0]),(t_dst[i][1] - r2[1])))
        t2RectInt.append((int(t2Rect[i][0]), int(t2Rect[i][1])))
    srcRect = src[r1[1]:r1[1]+r1[3], r1[0]:r1[0]+r1[2]]
    warpMat = cv2.getAffineTransform(np.float32(t1Rect), np.float32(t2Rect))
    dstRect = cv2.warpAffine(srcRect, warpMat, (r2[2], r2[3]), None, flags=cv2.INTER_LINEAR, borderMode=cv2.BORDER_REFLECT_101)
    mask = np.zeros((r2[3], r2[2], 3), dtype=np.uint8)
    cv2.fillConvexPoly(mask, np.int32(t2RectInt), (1,1,1), 16, 0)
    return dstRect * mask, mask

def alien_morph(image_path, output_path):
    img = cv2.imread(image_path)
    pts = get_landmarks(img)
    if pts is None:
        print("顔検出できません")
        return
    h,w = img.shape[:2]
    rect = (0,0,w,h)
    tris = delaunay_triangles(rect, pts)

    # 1) 変形目標（ここで“エイリアン化”を定義）
    pts_dst = pts.copy()
    # 例：目(33,133など)を拡大、顎(199付近)を尖らせる — indexはMediaPipeの仕様に依存
    # 簡易に全体を縦に伸ばして顔を細長くする:
    cx = np.mean([p[0] for p in pts])
    cy = np.mean([p[1] for p in pts])
    for i,(x,y) in enumerate(pts_dst):
        # y を中心に引き伸ばす（係数を調整）
        dy = y - cy
        pts_dst[i] = (int(x + 0.0*(x-cx)), int(cy + 1.2*dy))

    # 2) 三角形ごとにワープ
    output = np.zeros_like(img)
    mask_total = np.zeros_like(img)
    for tri in tris:
        t_src = [pts[i] for i in tri]
        t_dst = [pts_dst[i] for i in tri]
        warped, mask = warp_triangle(img, output, t_src, t_dst)
        r2 = cv2.boundingRect(np.float32([t_dst]))
        x,y,w2,h2 = r2
        if w2>0 and h2>0:
            output[y:y+h2, x:x+w2] = output[y:y+h2, x:x+w2] * (1 - mask) + warped

    # 3) 顔領域マスク（凸包）
    hull = cv2.convexHull(np.array(pts_dst), returnPoints=True)
    mask_face = np.zeros((h,w,3), dtype=np.uint8)
    cv2.fillConvexPoly(mask_face, np.int32(hull), (255,255,255))

    center = (w//2, h//2)
    # 4) 色や質感を馴染ませる：Poisson ブレンディング
    cloned = cv2.seamlessClone(output, img, mask_face[:,:,0], center, cv2.NORMAL_CLONE)

    cv2.imwrite(output_path, cloned)
    print("保存:", output_path)

if __name__ == "__main__":
    alien_morph("input.jpg", "alien_output.jpg")

